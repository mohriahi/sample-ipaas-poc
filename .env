# Sample Demo iPaaS configuration — loaded by start.sh / stop.sh / integrations/build.sh
# and used for variable interpolation in the docker-compose.yml files.

# WSO2 API Manager version (must match a valid wso2/wso2am image on Docker Hub)
WSO2AM_VERSION=4.7.0

# MySQL database backing WSO2 API Manager (replaces the embedded H2 database)
MYSQL_VERSION=8.4.9
# POC-only default, not meant for production use.
MYSQL_ROOT_PASSWORD=root
# Must match the WSO2 API Manager version's expected MySQL Connector/J driver;
# downloaded by apim/api-manager/setup.sh (not bundled, GPL licensing).
MYSQL_CONNECTOR_VERSION=8.4.0

# Shared Docker network between WSO2 API Manager and the WSO2 Integrator integrations
NETWORK_NAME=ipaas-network

# Ports exposed on the host for WSO2 API Manager
WSO2AM_HTTPS_PORT=9443
WSO2AM_GATEWAY_HTTPS_PORT=8243
WSO2AM_GATEWAY_HTTP_PORT=8280

# Port exposed on the host for the "hello-world" WSO2 Integrator integration.
# NOTE: kept away from 9090/9091/9092, which are used on the host by the
# WSO2 API Platform Self-Hosted Gateway (saas/hybrid mode) — see
# apim/saas-hybrid-gateway/wso2apip-api-gateway-*/docker-compose.yml.
HELLO_WORLD_PORT=9095

# WSO2 Integration Control Plane (ICP) version (must match a valid
# wso2/wso2-integration-control-plane image on Docker Hub)
ICP_VERSION=2.0.0

# Ports exposed on the host for the ICP (embedded H2 database, POC-only —
# not meant for production use). Default console credentials: admin / admin.
ICP_HTTPS_PORT=9446
ICP_RUNTIME_PORT=9445

# Observability (Prometheus + Grafana + Loki/Promtail) — see observability/README.md
PROMETHEUS_VERSION=v2.55.1
GRAFANA_VERSION=11.3.0
LOKI_VERSION=3.6.1
PROMTAIL_VERSION=3.6.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
# POC-only default, not meant for production use.
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus JMX exporter (must match a valid jmx_prometheus_javaagent
# release: https://github.com/prometheus/jmx_exporter/releases)
JMX_EXPORTER_VERSION=1.6.0

# Ports exposed on the host for Prometheus metrics endpoints (/metrics)
HELLO_WORLD_METRICS_PORT=9797
WSO2AM_METRICS_PORT=9798
