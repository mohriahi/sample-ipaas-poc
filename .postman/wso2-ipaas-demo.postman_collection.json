    {
      "name": "5. Audit logs (DevPortal)",
      "description": "Actions tracées dans audit.log (panel « Audit logs » du dashboard Logs) : création puis suppression d'une application. À exécuter dans l'ordre.",
      "item": [
        {
          "name": "a. Enregistrer un client OAuth (DCR)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apim}}/client-registration/v0.17/register",
            "description": "Dynamic Client Registration (Basic admin).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"callbackUrl\": \"www.example.com\",\n  \"clientName\": \"postman_demo\",\n  \"owner\": \"admin\",\n  \"grantType\": \"password refresh_token\",\n  \"saasApp\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{apimUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{apimPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('clientId', b.clientId);",
                  "pm.collectionVariables.set('clientSecret', b.clientSecret);",
                  "pm.test('client registered', () => pm.expect(b.clientId).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "b. Obtenir un token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('accessToken', pm.response.json().access_token);",
                  "pm.test('token received', () => pm.expect(pm.response.json().access_token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{apim}}/oauth2/token",
            "description": "Password grant, scopes DevPortal applications.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{clientId}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{clientSecret}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "username",
                  "value": "{{apimUser}}"
                },
                {
                  "key": "password",
                  "value": "{{apimPassword}}"
                },
                {
                  "key": "scope",
                  "value": "apim:subscribe apim:app_manage"
                }
              ]
            }
          }
        },
        {
          "name": "c. Créer une application",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apim}}/api/am/devportal/v3/applications",
            "description": "→ ligne d'audit « created Application ».",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"demo-audit-{{$timestamp}}\",\n  \"throttlingPolicy\": \"Unlimited\",\n  \"description\": \"Cr\\u00e9\\u00e9e depuis Postman pour la d\\u00e9mo des audit logs\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('appId', pm.response.json().applicationId);",
                  "pm.test('application created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "d. Supprimer l'application",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{apim}}/api/am/devportal/v3/applications/{{appId}}",
            "description": "→ ligne d'audit « deleted Application ».",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('application deleted', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
