    {
      "name": "4. API Logs (API REST DevOps)",
      "description": "Niveau d'API Logs par API, à chaud (sans redémarrage). BASIC = contexte, ressource, correlationId, flux, IP, méthode, statut ; STANDARD = + headers ; FULL = + payload. Résultat : panel « API Logs » du dashboard Logs.",
      "item": [
        {
          "name": "Lister les niveaux (récupère apiId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{apim}}/api/am/devops/v0/tenant-logs/carbon.super/apis",
            "description": "Récupère l'id de l'API HelloWorld dans la variable `apiId`.",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{apimUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{apimPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const api = pm.response.json().apis.find(a => a.context === '/hello-world/1.0' && a.resourceMethod === null);",
                  "pm.test('HelloWorld API found', () => pm.expect(api).to.be.ok);",
                  "pm.collectionVariables.set('apiId', api.apiId);",
                  "console.log('apiId=' + api.apiId + ' logLevel=' + api.logLevel);"
                ]
              }
            }
          ]
        },
        {
          "name": "Passer en FULL (headers + payload)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{apim}}/api/am/devops/v0/tenant-logs/carbon.super/apis/{{apiId}}",
            "description": "Relancer ensuite un appel du dossier 1 : api.log contient alors headers et payload.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"logLevel\": \"FULL\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{apimUser}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{apimPassword}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('log level updated', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
