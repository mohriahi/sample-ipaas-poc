  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Correlation ID returned by the gateway (wso2am runs with",
          "// -Dcorrelation_header_name=traceparent, so it echoes it in \"traceparent\").",
          "const corr = pm.response.headers.get('traceparent');",
          "const traceId = pm.variables.get('traceId');                // set by folder \"1\" pre-request",
          "const g = pm.collectionVariables.get('grafana');",
          "if (!corr) { return; }                                       // not a gateway response",
          "// Id to look up: the trace ID when we sent one, else the correlation ID (UUID)",
          "const id = traceId || corr;",
          "const range = 'from=now-1h&to=now';",
          "const explore = g + '/explore?schemaVersion=1&panes=' + encodeURIComponent(JSON.stringify({",
          "    a: { datasource: 'tempo', range: { from: 'now-1h', to: 'now' },",
          "         queries: [{ refId: 'A', datasource: { type: 'tempo', uid: 'tempo' }, queryType: 'traceql',",
          "                     query: traceId ? traceId : '{span.\"span.activity.id\"=\"urn:uuid:' + corr + '\"}' }] } }));",
          "const links = {",
          "    'Trace (Tempo, Explore)': explore,",
          "    'Dashboard Traces (id)': g + '/d/wso2-traces?' + range + '&var-id=' + encodeURIComponent(id),",
          "    'Dashboard Logs (id)': g + '/d/wso2-logs?' + range + '&var-id=' + encodeURIComponent(id),",
          "    'Dashboard Overview': g + '/d/ipaas-poc-overview?from=now-15m&to=now'",
          "};",
          "console.log('status=' + pm.response.code, '| trace_id=' + (traceId || '(généré par la gateway)'), '| correlation_id=' + corr);",
          "Object.entries(links).forEach(([k, v]) => console.log(k + ': ' + v));",
          "pm.visualizer.set(`",
          "  <div style=\"font-family:sans-serif;font-size:14px\">",
          "    <p><b>HTTP {{status}}</b> — trace_id: <code>{{traceId}}</code><br>correlation_id: <code>{{corr}}</code></p>",
          "    <p style=\"color:#666\">Tempo indexe la trace pour la recherche en ~30 s (le lien Explore par trace ID marche tout de suite).</p>",
          "    <ul>{{#each links}}<li><a href=\"{{this.url}}\" target=\"_blank\">{{this.name}}</a></li>{{/each}}</ul>",
          "  </div>`,",
          "  { status: pm.response.code, traceId: traceId || '(généré par la gateway — voir correlation_id)', corr: corr,",
          "    links: Object.entries(links).map(([name, url]) => ({ name, url })) });"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Via la gateway — appel tracé (traceparent)",
      "description": "Client instrumenté : chaque requête envoie un traceparent W3C et publie son span client (postman-client) dans Tempo. Trace complète postman-client → wso2am-gateway → hello-world.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// New W3C traceparent per request → same trace ID in Tempo, correlation.log,",
              "// api.log, gateway access log and hello-world logs.",
              "const hex = n => Array.from({ length: n }, () => Math.floor(Math.random() * 16).toString(16)).join('');",
              "const traceId = hex(32), spanId = hex(16);",
              "pm.variables.set('traceId', traceId);",
              "pm.variables.set('spanId', spanId);",
              "pm.variables.set('startMs', Date.now());",
              "pm.request.headers.upsert({ key: 'traceparent', value: `00-${traceId}-${spanId}-01` });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Send the client span (\"postman-client\") to Tempo (OTLP/HTTP) — without it",
              "// Grafana shows the trace as \"root span not yet received\".",
              "const start = pm.variables.get('startMs'), end = Date.now(), code = pm.response.code;",
              "const traceId = pm.variables.get('traceId'), spanId = pm.variables.get('spanId');",
              "pm.variables.unset('traceId');   // so later, untraced requests don't reuse it",
              "pm.sendRequest({",
              "    url: pm.collectionVariables.get('otlp') + '/v1/traces', method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify({ resourceSpans: [{",
              "        resource: { attributes: [{ key: 'service.name', value: { stringValue: 'postman-client' } }] },",
              "        scopeSpans: [{ spans: [{",
              "            traceId: traceId, spanId: spanId,",
              "            name: pm.request.method + ' ' + pm.request.url.getPath(), kind: 3,",
              "            startTimeUnixNano: String(start) + '000000', endTimeUnixNano: String(end) + '000000',",
              "            status: { code: code >= 400 ? 2 : 1 },",
              "            attributes: [",
              "                { key: 'http.method', value: { stringValue: pm.request.method } },",
              "                { key: 'http.url', value: { stringValue: pm.request.url.toString() } },",
              "                { key: 'http.status_code', value: { intValue: code } } ] }] }] }] }) }",
              "}, err => { if (err) console.log('OTLP export failed (Tempo up?)', err); });"
            ]
          }
        }
      ],
