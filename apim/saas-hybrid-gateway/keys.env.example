# WSO2 Integration Platform Self-Hosted Gateway connection secrets.
#
# Copy this file to "keys.env" (same folder, gitignored) and fill in the
# real values retrieved from the WSO2 Integration Platform console
# ("Configure the Gateway" step — see README.md, Step 1).
#
# ./setup.sh copies keys.env into the downloaded gateway release
# (configs/keys.env) on every run, so it survives even if that release
# folder is deleted and re-downloaded.

MOESIF_KEY=
GATEWAY_CONTROLPLANE_HOST=connect.bijira.dev
GATEWAY_REGISTRATION_TOKEN=
