          "expr": "sum(rate(traces_spanmetrics_calls_total{service=\"wso2am-gateway\", api_name!=\"\", http_status_code=~\"4..|5..\"}[$__rate_interval])) / sum(rate(traces_spanmetrics_calls_total{service=\"wso2am-gateway\", api_name!=\"\"}[$__rate_interval]))",
