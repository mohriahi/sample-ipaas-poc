{
  "uid": "wso2-traces",
  "title": "WSO2 iPaaS \u2014 Traces",
  "tags": [
    "wso2-observability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "wso2-observability"
      ],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "title": "WSO2 dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "id",
        "label": "Trace ID or Correlation ID",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 1,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "Every request through the gateway is one trace: (**demo-client** when sent by generate-traffic.sh \u2192) **wso2am-gateway** spans (CORS, key validation, throttling, mediation, backend call) \u2192 **hello-world** span. Click a trace ID to open it; from a span, *Logs for this span* jumps to Loki."
      }
    },
    {
      "type": "row",
      "title": "RED per service (derived from traces)",
      "collapsed": false,
      "panels": [],
      "id": 2,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 2
      }
    },
    {
      "type": "timeseries",
      "title": "Requests / s by service",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=\"wso2am-gateway\", api_name!=\"\"}[$__rate_interval])) or sum by (service) (rate(traces_spanmetrics_calls_total{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Requests per second received by the gateway and by each service."
    },
    {
      "type": "timeseries",
      "title": "Gateway errors / s (4xx/5xx)",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_status_code) (rate(traces_spanmetrics_calls_total{service=\"wso2am-gateway\", api_name!=\"\", http_status_code=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{http_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by service",
      "id": 5,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{service=\"wso2am-gateway\", api_name!=\"\"}[$__rate_interval])) or sum by (le, service) (rate(traces_spanmetrics_latency_bucket{span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "row",
      "title": "Find a request by trace ID or correlation ID",
      "collapsed": false,
      "panels": [],
      "id": 6,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 11
      }
    },
    {
      "type": "table",
      "title": "Requests matching the ID (empty = latest requests)",
      "id": 7,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{span.\"span.activity.id\"=~\".*$id.*\"} || {trace:id=\"$id\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "description": "Paste a trace ID or a correlation ID (e.g. 18982cf6-3483-\u2026). For an ID of the form 00-<32 characters>-<16 characters>-01, paste only the 32-character middle part."
    },
    {
      "type": "row",
      "title": "Find traces",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      }
    },
    {
      "type": "table",
      "title": "Recent gateway requests",
      "id": 9,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"wso2am-gateway\" && name=~\".+--.+--.+\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "table",
      "title": "Failed requests (gateway 4xx/5xx)",
      "id": 10,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{span.\"span.http.response.status.code\"=~\"4..|5..\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "table",
      "title": "Slow requests (> 200 ms at the gateway \u2014 empty is good)",
      "id": 11,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"wso2am-gateway\" && name=~\".+--.+--.+\" && duration > 200ms}",
          "limit": 20,
          "tableType": "traces"
        }
      ]
    },
    {
      "type": "table",
      "title": "hello-world spans",
      "id": 12,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{resource.service.name=\"/hello\"}",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "description": "hello-world appears under the name /hello (its URL path)."
    },
    {
      "type": "row",
      "title": "Service graph",
      "collapsed": false,
      "panels": [],
      "id": 13,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      }
    },
    {
      "type": "nodeGraph",
      "title": "Service graph",
      "id": 14,
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ],
      "description": "The link between the gateway and hello-world is not drawn here, because of how the gateway reports its steps. Open any trace to see the full path."
    }
  ]
}
