        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "The link between the gateway and hello-world is not drawn here, because of how the gateway reports its steps. Open any trace to see the full path."
    },
    {
      "type": "timeseries",
      "title": "Server latency p95 per service",
      "id": 18,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, server) (rate(traces_service_graph_request_server_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{server}}"
